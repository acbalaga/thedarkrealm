{
  "name": "thedarkrealm",
  "version": "1.0.0",
  "private": true,
  "description": "The Dark Realm. An offline idle browser game. The game itself has no dependencies; Wrangler is only for deploying.",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "dev": "wrangler dev",
    "deploy": "npm run stamp && wrangler deploy",
    "check": "node tools/check.js",
    "sim": "node tools/sim.js",
    "e2e": "node --test \"tests/e2e/*.spec.js\"",
    "stamp": "node tools/stamp-sw.js",
    "baseline": "node tools/baseline.js"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "wrangler": "4.162.0"
  },
  "engines": {
    "node": ">=22"
  }
}
